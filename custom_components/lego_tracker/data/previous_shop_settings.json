{
  "format": "lot-shop-settings",
  "version": 1,
  "notice": "The shop settings this installation used before version 1.0.0, carried over once so it keeps working. They are only used after you accept the terms in the panel. It is not a recommendation, not an instruction and not a statement that any of these websites allows its pages to be read automatically. You decide yourself which websites your Home Assistant contacts, and you alone are responsible for everything that happens between your Home Assistant and those websites: respecting their terms of use, robots.txt and the law that applies to you, and all legal consequences. The software is provided as is, without any warranty; to the fullest extent permitted by law, its author and contributors cannot be held liable. Use it only for personal, non-commercial purposes and moderately. LEGO and the names of shops are trademarks of their owners; this project is not affiliated with or endorsed by any of them.",
  "lego_locale": "nl-be",
  "shops": [
    {
      "id": "lego_com",
      "name": "LEGO.com",
      "domain": "lego.com",
      "reader": "lego",
      "home": "https://www.lego.com/",
      "search": "https://www.lego.com/{locale}/search?q={number}",
      "product": "https://www.lego.com/{locale}/product/{number}",
      "aliases": [
        "lego.com",
        "lego shop",
        "lego store",
        "lego"
      ]
    },
    {
      "id": "amazon_nl",
      "name": "Amazon.nl",
      "domain": "amazon.nl",
      "reader": "marketplace",
      "home": "https://www.amazon.nl/",
      "search": "https://www.amazon.nl/s?k={query}",
      "aliases": [
        "amazon.nl",
        "amazon nl",
        "amazon nederland"
      ]
    },
    {
      "id": "amazon_de",
      "name": "Amazon.de",
      "domain": "amazon.de",
      "reader": "marketplace",
      "home": "https://www.amazon.de/",
      "search": "https://www.amazon.de/s?k={query}",
      "aliases": [
        "amazon.de",
        "amazon de",
        "amazon duitsland"
      ]
    },
    {
      "id": "amazon_be",
      "name": "Amazon.com.be",
      "domain": "amazon.com.be",
      "reader": "marketplace",
      "home": "https://www.amazon.com.be/",
      "search": "https://www.amazon.com.be/s?k={query}",
      "aliases": [
        "amazon.com.be",
        "amazon.be",
        "amazon be",
        "amazon belgi"
      ]
    },
    {
      "id": "bol",
      "name": "bol.com",
      "domain": "bol.com",
      "reader": "partner",
      "home": "https://www.bol.com/nl/nl/",
      "search": "https://www.bol.com/nl/nl/s/?searchtext={query}",
      "aliases": [
        "bol.com",
        "bol"
      ]
    },
    {
      "id": "kruidvat_be",
      "name": "Kruidvat.be",
      "domain": "kruidvat.be",
      "reader": "retail",
      "home": "https://www.kruidvat.be/nl/",
      "search": "https://www.kruidvat.be/nl/search?text={query}",
      "aliases": [
        "kruidvat.be",
        "kruidvat"
      ]
    },
    {
      "id": "dreamland_be",
      "name": "Dreamland.be",
      "domain": "dreamland.be",
      "reader": "generic",
      "search": "https://www.dreamland.be/e/nl/search?q={query}",
      "aliases": [
        "dreamland.be",
        "dreamland"
      ]
    }
  ],
  "comparison_sites": [
    {
      "id": "kieskeurig",
      "name": "Kieskeurig",
      "reader": "product_list",
      "hosts": [
        "www.kieskeurig.be",
        "www.kieskeurig.nl"
      ],
      "start": {
        "BE": "https://www.kieskeurig.be/search?q={query}",
        "NL": "https://www.kieskeurig.nl/search?q={query}"
      }
    },
    {
      "id": "shoparize",
      "name": "Shoparize",
      "reader": "listing",
      "hosts": [
        "www.shoparize.com"
      ],
      "start": {
        "GB": "https://www.shoparize.com/uk/q?q={query}",
        "*": "https://www.shoparize.com/{cc_lower}/q?q={query}"
      }
    },
    {
      "id": "channable",
      "name": "Channable Shopping",
      "reader": "listing",
      "hosts": [
        "shopping.channable.com"
      ],
      "start": {
        "*": "https://shopping.channable.com/?country={cc}&search={query}"
      }
    },
    {
      "id": "producthero",
      "name": "Producthero",
      "reader": "inertia",
      "hosts": [
        "shopping.producthero.com"
      ],
      "langs": [
        "nl",
        "fr",
        "de",
        "en"
      ],
      "start": {
        "*": "https://shopping.producthero.com/{lang}/product/{ean14}?country={cc_lower}"
      }
    },
    {
      "id": "market_value",
      "name": "Market value",
      "reader": "market",
      "hosts": [
        "www.brickeconomy.com"
      ],
      "start": {
        "*": "https://www.brickeconomy.com/set/{number}-1/"
      }
    }
  ],
  "data_sources": {
    "set_data_api": "https://brickset.com/api/v3.asmx/getSets",
    "set_data_page": "https://brickset.com/sets/{number}-1",
    "parts_api": "https://rebrickable.com/api/v3/lego",
    "set_database_sets": "https://cdn.rebrickable.com/media/downloads/sets.csv.gz",
    "set_database_themes": "https://cdn.rebrickable.com/media/downloads/themes.csv.gz",
    "partner_api_token": "https://login.bol.com/token",
    "partner_api": "https://api.bol.com/marketing/catalog/v1"
  },
  "legacy": {
    "_comment": "Identifiers of versions before 1.1, translated once to the current ones.",
    "readers": {
      "amazon": "marketplace",
      "bol": "partner",
      "kruidvat": "retail"
    },
    "data_sources": {
      "brickset_api": "set_data_api",
      "brickset_page": "set_data_page",
      "rebrickable_api": "parts_api",
      "bol_api_token": "partner_api_token",
      "bol_api": "partner_api"
    },
    "comparison_readers": {
      "kieskeurig": "product_list",
      "producthero": "inertia",
      "market_value": "market",
      "shoparize": "listing",
      "channable": "listing"
    },
    "options": {
      "brickset_api_key": "set_data_api_key",
      "rebrickable_api_key": "parts_api_key",
      "bol_client_id": "partner_client_id",
      "bol_client_secret": "partner_client_secret",
      "bol_country": "partner_country",
      "brickwatch": "compare_sites"
    },
    "compare_ids": {
      "brickeconomy": "market"
    },
    "sources": {
      "Brickset": "set_data_api",
      "brickset.com": "set_data_page",
      "Rebrickable": "parts_api",
      "LEGO.com": "official"
    },
    "removed_source": {
      "key": "brickwatch",
      "hosts": [
        "brickwatch.net"
      ]
    },
    "labels": {
      "BrickEconomy": "Market value"
    }
  }
}
